APP_NAME=WayMate
APP_ENV=local
APP_KEY=base64:iz24qQ5PF25qUklMHGoTDdDr2ddfnr5c+ZKysdBNb6o=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=waymate
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@waymate.local"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SMS delivery: log (local only), bulksmsbd, sslwireless, twilio.
# In local mode the log driver also returns the code to the web UI.
SMS_DRIVER=log
SMS_TIMEOUT_SECONDS=15

# BulkSMSBD (https://bulksmsbd.net)
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=

# SSL Wireless ISMS Plus v3
SSLWIRELESS_API_TOKEN=
SSLWIRELESS_SID=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_DAILY_QUOTA=500
WAYMATE_OTP_TTL=300
WAYMATE_OTP_MAX_ATTEMPTS=5
WAYMATE_OTP_RESEND_COOLDOWN=60
WAYMATE_OTP_MAX_REQUESTS=5
WAYMATE_OTP_REQUEST_WINDOW=600
WAYMATE_MATCH_CORRIDOR_M=1200
WAYMATE_MATCH_MIN_OVERLAP_M=500
WAYMATE_MATCH_MIN_COS=0.5
WAYMATE_MATCH_SCORE_THRESHOLD=55
WAYMATE_MATCH_LEAD_TIME_MIN=15
WAYMATE_MATCH_HORIZON_DAYS=7
WAYMATE_MATCH_OFFER_WINDOW_MIN=60
WAYMATE_MATCH_REQUEST_WINDOW_MIN=90
WAYMATE_MATCH_SEARCH_LIMIT=100
WAYMATE_FARE_MAX_VERSION=3
WAYMATE_FARE_VOTE_WINDOW_MIN=10
WAYMATE_JOIN_REQUEST_TTL_HOURS=24
WAYMATE_JOIN_OFFER_TTL_HOURS=12
WAYMATE_MAP_CACHE_TTL_DAYS=30

FILESYSTEM_DISK=local
